# ==============================================================================
# CampaignLift Environment Configuration
# Canonical planning sources:
# - planning/architecture_plan.md
# - planning/backend_plan.md
# ==============================================================================

# Application environment (local | aws)
APP_ENV=local

# SQLite connection URL (or PostgreSQL URL for production)
DATABASE_URL=sqlite:///./campaignlift.db

# Path to machine learning model artifact directory containing model.joblib and metadata.json
MODEL_ARTIFACT_DIR=artifacts/models/cl-model-ml_dev_20261006-lgbm_s_learner-r01

# Active dataset version allowed for inference
DATASET_VERSION=cl-synth-ml_dev-20261006-8ad556a

# Path to pre-generated customer feature table for inference
FEATURE_TABLE_PATH=data/fixtures/fixture_v1/features.json

# Gemini API configuration (server-side only; missing key disables copilot only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
