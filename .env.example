# ==============================================================================
# CampaignLift Production Environment Configuration Template
#
# INSTRUCTIONS:
# Copy this file to .env on your VPS/AWS EC2 instance and fill in your values.
# NEVER commit .env to version control or bake secrets into Docker images.
# ==============================================================================

# ------------------------------------------------------------------------------
# Network & Ingress Configuration
# ------------------------------------------------------------------------------
# Public port mapped to host (default: 80)
PORT=80

# Container images (published to GitHub Container Registry)
# Replace <owner> with your GitHub organization or username (e.g. mosabbir-maruf)
FRONTEND_IMAGE=ghcr.io/<owner>/campaignlift-frontend:latest
BACKEND_IMAGE=ghcr.io/<owner>/campaignlift-backend:latest

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
# Application environment (local | aws | production)
APP_ENV=production

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# SQLite persistent database URL mounted inside container volume (/app/db)
DATABASE_URL=sqlite:////app/db/campaignlift.db

# ------------------------------------------------------------------------------
# Machine Learning Model & Artifacts
# ------------------------------------------------------------------------------
# Path to trained model directory containing model.joblib and metadata.json
MODEL_ARTIFACT_DIR=artifacts/models/cl-model-ml_dev_20261006-lgbm_s_learner-r01

# Path to pre-generated customer feature table for inference
FEATURE_TABLE_PATH=data/fixtures/fixture_v1/features.json

# Dataset version identifier allowed for scoring
DATASET_VERSION=cl-synth-ml_dev-20261006-8ad556a

# ------------------------------------------------------------------------------
# LLM & Copilot Integration (Server-Side Only)
# ------------------------------------------------------------------------------
# Optional Gemini API key for campaign intelligence copilot
# If left blank, copilot returns graceful 503 while all other screens remain functional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
